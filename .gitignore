# OS / editor
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
.venv/

# Local secrets (never commit credentials)
.env
*.key

# Ingest inputs, renders and verbatim extracts stay local (decks may be client material).
# Only work/brief.json, work/brief-summary.md, work/log.md and work/security/ are committed,
# and brief.json only after the person has checked it for personal data (see SKILL.md).
input/
work/slides/
work/*.pdf
work/extract.json
work/brief.skeleton.json


# Presentation working files stay local
*.docx
*.pptx


# Real projects (client material) never enter the public repo
projects/

# Rhino files and their viewer exports are the team's model of a real place; only the sample's synthetic model is committed
*.3dm
work/model.json

